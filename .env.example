# Local/deployment environment template.
# Copy to .env only for local use. Never commit the real .env file.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
DJANGO_TIME_ZONE=Asia/Kabul
DJANGO_SECURE_SSL_REDIRECT=False

# PostgreSQL / Neon. Leave blank locally to use SQLite.
# Example shape only — never commit a real Neon password:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Optional media directory. Render Free has an ephemeral filesystem.
DJANGO_MEDIA_ROOT=media

# Optional first-admin bootstrap for deployment.
# Set these as private Render environment variables, not in GitHub.
MMS_ADMIN_USERNAME=
MMS_ADMIN_EMAIL=
MMS_ADMIN_PASSWORD=
